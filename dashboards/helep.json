{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "Prometheus",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(helep_sos_triggers_total[5m])",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "title": "SOS triggers / second",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(helep_notifications_sent_total[5m])",
          "legendFormat": "{{channel}}/{{template}}",
          "refId": "A"
        }
      ],
      "title": "Notifications delivered / second",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "1 / clamp_min(rate(helep_dispatch_assigned_total[5m]), 0.001)",
          "legendFormat": "estimated_seconds",
          "refId": "A"
        }
      ],
      "title": "Dispatch latency (estimated seconds/event)",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 37,
  "style": "dark",
  "tags": ["helep"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HELEP Overview",
  "uid": "helep-overview",
  "version": 1
}
